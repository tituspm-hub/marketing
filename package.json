    "@types/node": "^26.4.0",
    "@vercel/node": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/ui": "^4.1.11",
    "firebase-tools": "^15.28.2",
    "jsdom": "^30.0.1",
